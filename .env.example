# Copy to .env and fill in. Never commit .env.
#
# Every value is read at startup and a missing required one aborts the process, so a
# misconfigured deploy fails loudly instead of quietly running on a default.

APP_ENV=development

# The port the api listens on *inside* its container. Nothing reaches it from outside in a real
# deployment - Caddy is the only thing published - so change it only if something on the compose
# network already holds it. docker-compose.yml and deploy/Caddyfile both follow this value.
PORT=8787
HOST=0.0.0.0

# What Caddy publishes on the host. Leave these alone unless something else on the box already has
# 80/443: moving 443 means every client has to name the port, and moving 80 breaks Let's Encrypt's
# HTTP-01 challenge, so Caddy would need a DNS challenge instead.
HTTP_PORT=80
HTTPS_PORT=443

# Used by the api container. Host is the compose service name.
DATABASE_URL=jdbc:postgresql://postgres:5432/kotatsuredo
DATABASE_USER=kotatsuredo
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10

# Consumed by the postgres container itself.
POSTGRES_DB=kotatsuredo
POSTGRES_USER=kotatsuredo
POSTGRES_PASSWORD=change-me

# Domain Caddy should request a certificate for. Use `localhost` for local runs.
SERVER_DOMAIN=localhost

# Peppers the device hashes. No default, and changing it invalidates every device ban.
DEVICE_PEPPER=generate-a-long-random-string

# The first moderator account, created once on a server whose moderator table is empty.
#
# The path disables itself as soon as any moderator exists, so leaving these set is harmless - but
# remove them anyway, and change the password from the panel after the first sign-in. The account
# has to enrol an authenticator before it can do anything at all.
MOD_BOOTSTRAP_USERNAME=
MOD_BOOTSTRAP_PASSWORD=

# Local only, and read by docker-compose.test.yml alone: where the published ports land on the host.
# The production compose file publishes neither.
API_HOST_PORT=8787
POSTGRES_HOST_PORT=5432
