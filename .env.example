# Copy to .env and fill in. Never commit .env.
#
# Every value is read at startup and a missing required one aborts the process, so a
# misconfigured deploy fails loudly instead of quietly running on a default.

APP_ENV=development

# The port the api listens on *inside* its container. Nothing reaches it from outside in a real
# deployment - Caddy is the only thing published - so change it only if something on the compose
# network already holds it. docker-compose.yml and deploy/Caddyfile both follow this value.
PORT=8787
HOST=0.0.0.0
# Set only when the API cannot be reached except through the configured reverse proxy.
TRUST_PROXY_HEADERS=true
# Compose terminates TLS at Caddy; keep admin cookies HTTPS-only even if APP_ENV is development.
SECURE_COOKIES=true

# What Caddy publishes on the host. Leave these alone unless something else on the box already has
# 80/443: moving 443 means every client has to name the port, and moving 80 breaks Let's Encrypt's
# HTTP-01 challenge, so Caddy would need a DNS challenge instead.
HTTP_PORT=80
HTTPS_PORT=443

# Used by the long-lived api container. Host is the compose service name.
DATABASE_URL=jdbc:postgresql://postgres:5432/kotatsuredo
DATABASE_USER=kotatsuredo_app
DATABASE_PASSWORD=generate-a-separate-runtime-password
DATABASE_POOL_SIZE=10

# Used only by the one-shot migration container; never passed to the API container.
DATABASE_MIGRATION_USER=kotatsuredo_owner
DATABASE_MIGRATION_PASSWORD=generate-a-migration-owner-password

# Consumed by the postgres container itself.
POSTGRES_DB=kotatsuredo
# Schema owner used by Flyway only. Do not reuse it as DATABASE_USER.
# Keep these equal to DATABASE_MIGRATION_USER/PASSWORD in the stock Compose deployment.
POSTGRES_USER=kotatsuredo_owner
POSTGRES_PASSWORD=generate-a-migration-owner-password

# Domain Caddy should request a certificate for. Use `localhost` for local runs.
SERVER_DOMAIN=localhost

# Where a filter rejection sends someone to read the rules. Must be absolute in production - it is
# shown in the app, which cannot resolve a relative path against the server.
RULES_URL=/rules

# Peppers the device hashes. No default, minimum 32 characters, and changing it invalidates every
# device ban. Generate one with: openssl rand -hex 32
DEVICE_PEPPER=

# Encrypts moderator authenticator seeds in PostgreSQL. Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Back this up separately; losing or changing it requires every moderator to re-enrol TOTP.
MOD_TOTP_ENCRYPTION_KEY=

# Shortest comment the server will accept, in characters a reader would count.
#
# Changing it takes effect on restart and needs nothing else: the app reads the limit off every
# comment page rather than holding its own copy, so no release is involved.
COMMENT_MIN_LENGTH=10

# Comments per hour, by trust tier. A new account is deliberately kept short on rope; raise these if
# your instance is small enough that the caution costs more than it buys.
#
# Keep them in order. Raising only the first gives a brand new account more rope than a settled one,
# which is the opposite of what the tiers exist for - the server logs a warning if you do.
RATE_COMMENTS_NEW=5
RATE_COMMENTS_NORMAL=20
RATE_COMMENTS_ESTABLISHED=40

# The first moderator account, created once on a server whose moderator table is empty.
#
# The path disables itself as soon as any moderator exists, so leaving these set is harmless - but
# remove them anyway, and change the password from the panel after the first sign-in. The account
# has to enrol an authenticator before it can do anything at all.
MOD_BOOTSTRAP_USERNAME=
MOD_BOOTSTRAP_PASSWORD=

# Local only, and read by docker-compose.test.yml alone: where the published ports land on the host.
# The production compose file publishes neither.
API_HOST_PORT=8787
POSTGRES_HOST_PORT=5432
