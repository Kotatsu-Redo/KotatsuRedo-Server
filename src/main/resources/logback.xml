<configuration>
	<!--
	  Deliberately plain. The pattern below is the only thing written per request, and CallLogging
	  builds that message from an allow-list of four fields (see plugins/Plugins.kt). Do not add
	  %header, %X{...} for anything credential-bearing, or a request-body encoder here.
	-->
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{call-id}] %logger{24} - %msg%n</pattern>
		</encoder>
	</appender>

	<!--
	  The same lines, on disk.

	  `docker compose logs` reads the current container's own buffer, so a redeploy erases the very
	  window an incident needs looking at - which is exactly how a day of evidence was lost once. This
	  writes to a volume that outlives the container, rotated and capped so it can never fill the box.
	  LOG_DIR is set by compose; the default keeps a local run from needing one.
	-->
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR:-logs}/server.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR:-logs}/server.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxFileSize>50MB</maxFileSize>
			<maxHistory>14</maxHistory>
			<totalSizeCap>1GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{call-id}] %logger{24} - %msg%n</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="STDOUT"/>
		<appender-ref ref="FILE"/>
	</root>

	<!-- Hikari and Flyway are chatty at DEBUG and say nothing useful at INFO once running. -->
	<logger name="com.zaxxer.hikari" level="WARN"/>
	<logger name="org.flywaydb" level="INFO"/>
	<logger name="io.netty" level="WARN"/>
</configuration>
